# Copy this file to .env.local and fill in real values before running
# `docker compose up`. The .env.local file is gitignored.
#
# Tokens used by triage and worker agents to interact with the platform APIs.
GITHUB_TOKEN=
GITLAB_TOKEN=

# Comma-separated list of usernames whose assigned issues should be polled
# by the triage agent's poll_issues reasoner.
ND_ASSIGNED_USERNAMES=

# Username (e.g. GitHub login) used to filter MR comments addressed to the
# current user when polling for actionable comments.
ND_CURRENT_USER=

